import java.lang.String;

/*
 * This model is taken from existing literature:
 * Gail-Joon Ahn and M. E. Shin, "Role-based authorization constraints specification using Object
 * Constraint Language," Proceedings Tenth IEEE International Workshop on Enabling Technologies:
 * Infrastructure for Collaborative Enterprises. WET ICE 2001, Cambridge, MA, USA, 2001, pp. 157-162,
 * doi: 10.1109/ENABL.2001.953406.
 */
classdiagram UserRef {

 public class User{
    String name ;
 }

 public class Session {
  String name ;
 }

 public class Role {
    String name ;
 }
 public class Permission {
    String name ;
 }

 public class UserRole extends Role ;
 public class AdministrativeRole extends Role;
 public class UserPermission extends Permission ;
 public class AdministrativePermission extends Permission ;

 association [1]  User  -> (sessions)Session[1..*] ;
 association userRoles [*]  User(users)  -> (roles)Role[*];
 association [*]  Permission(permissions)  <- (roles)Role[*];
}
