ocl bankingChecks {
  context Banking.SEPABank b inv OverallBalanceCorrect:
    let
      Set<double> balances = { acc.balance | Banking.PrivateAccount acc in b.privateAccount };
      double calculatedBalance = iterate { balance in balances;
                                    double accumulated = 0.0 :
                                    accumulated = accumulated + balance }
    in
      b.privateAccountsOverallBalance == calculatedBalance;


  context Banking.SEPABank b inv OverallBalanceCorrect:
    let
      Set<double> balances = { acc.balance | Banking.BusinessAccount acc in b.businessAccount };
      double calculatedBalance = iterate { balance in balances;
                                    double accumulated = 0.0 :
                                    accumulated = accumulated + balance }
    in
      b.businessAccountsOverallBalance == calculatedBalance;

  context Banking.SEPABank b inv OverallBalanceCorrectShorter:
    b.privateAccountsOverallBalance == iterate { balance in b.privateAccount.balance;
                      double accumulated = 0.0 :
                      accumulated = accumulated + balance };

  context Banking.SEPABank b inv OverallBalanceCorrectShorter:
    b.businessAccountsOverallBalance == iterate { balance in b.businessAccount.balance;
                      double accumulated = 0.0 :
                      accumulated = accumulated + balance };

  context Banking.PrivateAccount inv UniqueAccountId:
    forall a1 in PrivateAccount, a2 in PrivateAccount:
      a1.iban == a2.iban implies a1 == a2;

  context Banking.BusinessAccount inv UniqueAccountId:
    forall a1 in BusinessAccount, a2 in BusinessAccount:
      a1.iban == a2.iban implies a1 == a2;
}