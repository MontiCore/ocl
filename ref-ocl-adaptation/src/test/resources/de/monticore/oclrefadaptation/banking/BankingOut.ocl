ocl bankingChecks {
  context SEPABank b inv OverallBalanceCorrect:
  let
    balances = { acc.balance | BankAccount acc in b.bankAccount };
    calculatedBalance = iterate { balance in balances;
                                  double sum = 0.0 :
                                  sum = sum + balance }
  in
    b.totalMoney == calculatedBalance;
}