ocl TransactionChecks {

  context void Banking.BankAccount.withdraw(double amount)
     pre: this.availableFunds >= amount;
     post: this.availableFunds == this@pre.availableFunds - amount;
       // actually, we would also like to have the following here:
       // this.balance == this@pre.balance - amount;

  context Banking.SEPABank b inv OverallBalanceCorrectShorter:
      b.overallBalance == iterate { balance in b.bankAccount.balance;
                  double accumulated = 0.0 :
                  accumulated = accumulated + balance };

  context Banking.SEPABank b inv OverallBalanceCorrectShorter:
      b.overallAvailableFunds == iterate { balance in b.bankAccount.availableFunds;
                  double accumulated = 0.0 :
                  accumulated = accumulated + balance };
}