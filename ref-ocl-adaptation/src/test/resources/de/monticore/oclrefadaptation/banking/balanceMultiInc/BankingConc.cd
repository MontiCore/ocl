import java.lang.String;

classdiagram Banking {

  <<ref="Bank">> class SEPABank {
    <<ref="id">> String bic;
    <<ref="overallBalance", bind="Account.balance=BankAccount.balance">> double overallBalance;
    <<ref="overallBalance", bind="Account.balance=BankAccount.availableFunds">> double overallAvailableFunds;
  }

  <<ref="Account">> class BankAccount {
    <<ref="id">> String iban;
    <<ref="balance">> double balance; // money in the account
    <<ref="balance">> double availableFunds; // money that can be used for transactions
    void deposit(double amount);
    <<bind="Account.balance=BankAccount.availableFunds">> void withdraw(double amount);
    <<bind="Account.balance=BankAccount.availableFunds">> void transfer(BankAccount targetAccount, double amount);
  }

  // sends money from sourceAccount to targetAccount
  class Transaction {
    BankAccount sourceAccount;
    BankAccount targetAccount;
    <<ref="amount">> double transferValue;
  }

  association SEPABank -> BankAccount [*];
  association BankAccount -> Transaction [*] <<ordered>>;
}