ocl BuildResultHasCorrectPropertiesSwapped {

  context Employee EmployeeBuilder.build()
    post: mFirstName == result.firstName && mLastName == result.lastName
  			  && mNumber == result.number && mSalary == result.salary;

  context Department DepartmentBuilder.build()
    post: mManagerName == result.managerName && mDepId == result.depId;
}
