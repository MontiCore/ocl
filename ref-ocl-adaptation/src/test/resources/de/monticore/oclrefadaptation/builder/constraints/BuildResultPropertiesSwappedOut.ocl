ocl BuildResultHasCorrectPropertiesSwapped {

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
      post: mFirstName == result.firstName;

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
      post: mLastName == result.lastName;

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
      post: mNumber == result.number;

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
      post: mSalary == result.salary;

  context BuilderConc.Department BuilderConc.DepartmentBuilder.build()
      post: mManagerName == result.managerName;

  context BuilderConc.Department BuilderConc.DepartmentBuilder.build()
      post: mDepId == result.depId;
}
