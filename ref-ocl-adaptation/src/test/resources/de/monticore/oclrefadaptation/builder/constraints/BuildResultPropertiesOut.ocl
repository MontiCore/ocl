ocl BuildResultHasCorrectProperties {

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
      post: result.firstName == mFirstName;

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
        post: result.lastName == mLastName;

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
        post: result.number == mNumber;

  context BuilderConc.Employee BuilderConc.EmployeeBuilder.build()
        post: result.salary == mSalary;

  context BuilderConc.Department BuilderConc.DepartmentBuilder.build()
          post: result.managerName == mManagerName;

  context BuilderConc.Department BuilderConc.DepartmentBuilder.build()
            post: result.depId == mDepId;
}
