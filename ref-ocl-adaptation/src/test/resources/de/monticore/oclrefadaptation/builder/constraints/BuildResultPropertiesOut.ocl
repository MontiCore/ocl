ocl BuildResultHasCorrectProperties {

  context Employee EmployeeBuilder.build()
    post: result.firstName == mFirstName && result.lastName == mLastName
  			  && result.number == mNumber && result.salary == mSalary;

  context Department DepartmentBuilder.build()
    post: result.managerName == mManagerName && result.depId == mDepId;
}
