import java.lang.String;

classdiagram BuilderRef {
  class DataClass {
    undef attribute;
  }

  <<forEach="DataClass">> class DataClassBuilder {
    /*
     * We need the prefixes to avoid TypeCheck issues because of function and variable symbol names
     * with the same name.
     * See https://github.com/MontiCore/ocl/pull/3
     */
    <<forEach="DataClass.attribute">> undef mAttribute;
    <<forEach="DataClass.attribute">> DataClassBuilder attribute(undef pAttribute);
    DataClass build();
  }
}
