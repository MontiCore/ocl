ocl MethodCallChangesBuildResultSwapped {

  // ----- Employee -----

  context EmployeeBuilder EmployeeBuilder.firstName(String firstName)
    post: firstName == this.build().firstName;

  context EmployeeBuilder EmployeeBuilder.lastName(String lastName)
    post: lastName == this.build().lastName;

  context EmployeeBuilder EmployeeBuilder.number(int number)
    post: number == this.build().number;

  context EmployeeBuilder EmployeeBuilder.salary(int salary)
    post: salary == this.build().salary;

  // ----- Department -----

  context DepartmentBuilder DepartmentBuilder.managerName(String managerName)
    post: managerName == this.build().managerName;

  context DepartmentBuilder DepartmentBuilder.depId(int depId)
    post: depId == this.build().depId;
}
