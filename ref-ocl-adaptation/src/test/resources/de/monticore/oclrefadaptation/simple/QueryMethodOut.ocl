ocl QueryMethod {
  context SimpleConc.User p inv AdultIf18:
    //p.hasReachedAgeOfMajority() <=> p.age >= 18;
    !p.hasReachedAgeOfMajority() || p.age >= 18 && !(p.age >= 18) || p.hasReachedAgeOfMajority();

  context boolean SimpleConc.User.hasReachedAgeOfMajority()
    //post: result == true <=> this.age >= 18;
    post: !(result == true) || this.age >= 18 && !(this.age >= 18) || result == true;
}